{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft-a-dynasty.local/schemas/free-agent-market-v1.schema.json",
  "title": "Draft a Dynasty Free Agent Market v1",
  "type": "object",
  "required": ["profile_schema_version", "market_id", "as_of_week", "entries"],
  "properties": {
    "profile_schema_version": { "const": 1 },
    "market_id": { "const": "free-agent-market" },
    "as_of_week": { "type": ["integer", "null"], "minimum": 0 },
    "review_after_week": { "type": ["integer", "null"], "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "player_name", "position", "availability", "evidence"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "player_name": { "type": "string", "minLength": 1 },
          "position": { "type": "string", "minLength": 1 },
          "availability": {
            "enum": ["FREE_AGENT", "WAIVERS", "PRACTICE_SQUAD_ELIGIBLE", "UNAVAILABLE"]
          },
          "evidence": {
            "enum": ["MODEL_INFERENCE", "PUBLIC_REPORT", "STAFF_SCOUTED", "TEAM_CONTACT", "VERIFIED"]
          },
          "overall_rating": { "type": ["integer", "null"], "minimum": 40, "maximum": 99 },
          "age": { "type": ["integer", "null"], "minimum": 18, "maximum": 50 },
          "development_trait": { "type": ["string", "null"] },
          "role": { "type": ["string", "null"] },
          "contract_expectation": { "type": ["string", "null"] },
          "football_notes": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "as_of_week": { "type": ["integer", "null"], "minimum": 0 },
          "review_after_week": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
